  "scene_actions": [
    {
      "key": "sync_now",
      "label": {
        "en": "Sync Foncia",
        "fr": "Synchroniser Foncia",
        "de": "Foncia synchronisieren",
        "es": "Sincronizar Foncia"
      },
      "description": {
        "en": "Read MyFoncia now and pass the figures of one account to the next actions.",
        "fr": "Lit MyFoncia maintenant et transmet les chiffres d'un compte aux actions suivantes.",
        "de": "Liest MyFoncia jetzt und gibt die Zahlen eines Kontos an die nächsten Aktionen weiter.",
        "es": "Lee MyFoncia ahora y pasa las cifras de una cuenta a las acciones siguientes."
      },
      "timeout_seconds": 120,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Foncia account",
            "fr": "Compte Foncia",
            "de": "Foncia-Konto",
            "es": "Cuenta Foncia"
          },
          "required": false,
          "description": {
            "en": "Empty = the first account.",
            "fr": "Vide = le premier compte.",
            "de": "Leer = das erste Konto.",
            "es": "Vacío = la primera cuenta."
          }
        }
      ],
      "outputs": [
