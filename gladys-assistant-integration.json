            "fr": "Synchro réussie",
            "de": "Synchronisierung erfolgreich",
            "es": "Sincronización correcta"
          }
        },
        {
          "key": "account",
          "type": "string",
          "label": {
            "en": "Account name",
            "fr": "Nom du compte",
            "de": "Kontoname",
            "es": "Nombre de la cuenta"
