        "de": "Ein Vorfall oder eine Reparatur wurde eröffnet oder ihr Status hat sich geändert.",
        "es": "Se ha abierto una incidencia o una reparación, o su estado ha cambiado."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Foncia account",
            "fr": "Compte Foncia",
            "de": "Foncia-Konto",
            "es": "Cuenta Foncia"
          },
          "required": false
        },
        {
