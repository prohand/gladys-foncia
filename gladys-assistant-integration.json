        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Document title",
            "fr": "Titre du document",
            "de": "Dokumenttitel",
            "es": "Título del documento"
          }
        },
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Document date",
            "fr": "Date du document",
            "de": "Dokumentdatum",
            "es": "Fecha del documento"
          }
