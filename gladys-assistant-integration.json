    {
      "key": "mark_documents_seen",
      "label": {
        "en": "Mark Foncia documents as seen",
        "fr": "Marquer les documents Foncia comme vus",
        "de": "Foncia-Dokumente als gesehen markieren",
        "es": "Marcar documentos de Foncia como vistos"
